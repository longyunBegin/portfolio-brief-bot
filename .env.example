
# ===== SMTP 邮件配置 =====
# 以 QQ 邮箱为例：smtp.qq.com:465，授权码作为密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_qq@qq.com
SMTP_PASS=your_smtp_auth_code
MAIL_FROM=your_qq@qq.com
MAIL_TO=eden@example.com

# ===== 券商/IBKR 配置 =====
# true=使用 mock 假数据；false=使用 IBKR 真实持仓
BROKER_USE_MOCK=false
# IBKR OAuth refresh_token 和 client_id（每次调用自动刷新 access_token）
IBKR_REFRESH_TOKEN=your_ibkr_refresh_token
IBKR_CLIENT_ID=your_ibkr_client_id

# ===== 腾讯云 COS（持久化 refresh_token，SCF 部署用）=====
# COS_ENABLED=true 时用 COS 存储 refresh_token；false 则本地用 .ibkr_refresh_token 文件
COS_ENABLED=false
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_KEY=ibkr_refresh_token

# ===== 通知策略 =====
# 是否仅在交易日发送（true 时跳过周末/节假日）
TRADE_DAY_ONLY=true
# 通知的交易日：收盘后次日 10:00 发送，此处配置发送时刻
NOTIFY_HOUR=10
NOTIFY_MINUTE=0
# Gmail 图表模式：html=表格迷你图（MCP 安全，Grok Bot 剥 <img> 时用）；
# dataUri=内嵌 PNG 图（仅直接调 Gmail API 发送时用，MCP 路径会剥掉图片变空白）
GMAIL_IMAGE_MODE=html
# ===== Gmail API 直发（绕过 MCP 剥样式；例程长期发信）=====
# 推荐：自有 GCP OAuth 客户端（Web application）
# 授权 scope：https://www.googleapis.com/auth/gmail.send
# access_type=offline + prompt=consent，才能拿到 refresh_token
GMAIL_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your_client_secret
GMAIL_OAUTH_REFRESH_TOKEN=your_refresh_token
# access token 由脚本发信前自动刷新；也可手动填未过期的值
GMAIL_OAUTH_TOKEN=
# 直发例程请设 GMAIL_IMAGE_MODE=dataUri（保留 PNG）；MCP 路径用 html
